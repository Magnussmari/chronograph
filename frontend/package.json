{
  "name": "human-history-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "aggregate:years": "cd .. && node frontend/scripts/aggregate-data.mjs",
    "aggregate:evidence": "cd .. && node frontend/scripts/aggregate-evidence.mjs",
    "aggregate:index": "node scripts/build-timeline-index.mjs",
    "aggregate": "npm run aggregate:years && npm run aggregate:evidence && npm run aggregate:index && npm run eras:build",
    "prebuild": "npm run aggregate",
    "eras:build": "cd .. && node scripts/eras/build-era-index.mjs",
    "eras:validate": "cd .. && node scripts/eras/validate-era-index.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/leaflet": "^1.9.22",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "motion": "^12.38.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
